# Copy to .env (which is git-ignored) and fill in. Never commit the real file.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/eshop
SPRING_DATASOURCE_USERNAME=eshopuser
SPRING_DATASOURCE_PASSWORD=
# Base64 key of at least 64 bytes:  openssl rand -base64 64
APPLICATION_SECURITY_JWT_SECRET_KEY=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_WEB_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Created on an empty database; remove after first start
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
